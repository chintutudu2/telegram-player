# Copy to .env.local. Firestore is the only catalog source: without the
# NEXT_PUBLIC_FIREBASE_* keys, catalog pages show a "Firebase not configured"
# screen; with them, an empty `media` collection shows a "no data" screen.

# --- Firebase (required for your catalog; public by design) ---
# Firebase console → Project settings → General → Your apps → Web app config.
# Also publish the Firestore security rules in the console (docs/PROJECT_GUIDE.md §5.2 F).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Playback (optional) ---
# Where `/<telegramFileId>` is streamed from. Default: this app's /api/stream proxy.
NEXT_PUBLIC_STREAM_BASE_URL=
# Clip played when a doc's telegramFileId is empty or a placeholder ("placeholder", "demo-1"…).
NEXT_PUBLIC_PREVIEW_STREAM_URL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Channel the bot administers; only its posts are ingested. e.g. -1001234567890
TELEGRAM_CHANNEL_ID=
# Optional: comma-separated user ids allowed to upload by DMing the bot.
TELEGRAM_ADMIN_IDS=
# Bearer token for /api/telegram/sync and the webhook secret_token (A-Z a-z 0-9 _ -).
TELEGRAM_SYNC_SECRET=
# Full-length streaming (MTProto): from https://my.telegram.org → API development tools.
# Without these, videos over 20 MB can't play (Bot API limit).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Helper bots for streaming (comma-separated tokens). Telegram limits how fast
# ONE bot can download (~0.85–2.5 MB/s, shared by everyone watching), so each
# helper adds capacity. ~3 viewers per bot: 3 helpers (4 bots) for 10 viewers.
# Create them in @BotFather and add each as an admin of TELEGRAM_CHANNEL_ID.
TELEGRAM_STREAM_BOT_TOKENS=
# Optional tuning: how much video to load ahead per viewer, and parallel requests.
TELEGRAM_STREAM_READAHEAD_MB=8
TELEGRAM_STREAM_PARALLEL=2

# --- Sign-in (required) ---
# Viewers sign up with email + password (Firebase console → Authentication →
# Sign-in method → enable Email/Password) and can watch once an admin approves
# them at /admin. Signs the session cookie; generate with: openssl rand -base64 48
AUTH_SECRET=
# Comma-separated emails that are approved automatically and can approve others.
ADMIN_EMAILS=
# Local tests against the Auth emulator:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Server deployment only (docker-compose.yml, see docs/PROJECT_GUIDE.md §8) ---
# Public domain pointing at the server, e.g. movies.example.com (HTTPS is automatic).
# Leave empty locally: deploy/push.sh writes it into the server's .env.
APP_DOMAIN=
# Used by deploy/push.sh on your Mac (never sent to the server):
# DEPLOY_HOST = SSH login of the server, DEPLOY_DOMAIN = its public domain.
DEPLOY_HOST=ubuntu@
DEPLOY_DOMAIN=

# --- Firebase Admin (optional; server-only, needed only for Telegram sync writes) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Service-account private key on one line with literal \n escapes.
FIREBASE_PRIVATE_KEY=
# Local development against the emulator (both SDKs honour it):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- TMDB (optional; posters, synopsis and rating for your uploads) ---
# Free: themoviedb.org → Settings → API. Use the "API Read Access Token"
# (or the v3 "API Key"). Values you set on a Firestore doc always win.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
