# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# debug and tool logs (Firebase emulators write *-debug.log here)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- secrets: never commit ----
# env files: .env.local (local) and .env (the server's copy, see deploy/push.sh)
.env*
!.env.example
# Firebase service-account keys and CLI state
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
.firebase/
.firebaserc
# private keys, certificates, SSH keys
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
oracle_tplayer*
# Telegram (GramJS) session files, if ever saved to disk
*.session

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
